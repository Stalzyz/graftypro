#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set timeout   120

puts "\n🚀 Syncing compose file..."
spawn rsync -avz --exclude="node_modules" --exclude=".git" --exclude=".env" docker-compose.prod.yml $SERVER:/root/grafty_bsp/
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

puts "\n🚀 Starting containers..."
spawn ssh -o StrictHostKeyChecking=no $SERVER "cd /root/grafty_bsp && docker compose -f docker-compose.prod.yml up -d"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

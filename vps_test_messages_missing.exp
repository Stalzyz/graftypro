#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set timeout   60

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "docker exec grafty_postgres psql -U user -d wabot_bsp -c \"SELECT id, type, content FROM messages WHERE type = 'TEMPLATE' AND content->>'template_name' IS NULL LIMIT 5;\""
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

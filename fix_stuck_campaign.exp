#!/usr/bin/expect -f
set SERVER "root@72.61.231.187"
set PASS "Photoshop09@"
set timeout 30

puts "=== Fixing Stuck PROCESSING Campaign in Production ==="
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "docker exec -i grafty_postgres psql -U user -d wabot_bsp -c \"UPDATE campaigns SET status = 'COMPLETED' WHERE status = 'PROCESSING' AND id = '9eaac403-a3e0-49cc-ba37-7822635164ac';\""
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

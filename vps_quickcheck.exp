#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set timeout   60

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "docker ps -a && echo '==LOGS==' && docker logs grafty_bsp-web-1 --tail 30 2>&1"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

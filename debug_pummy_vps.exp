#!/usr/bin/expect -f
set SERVER "root@72.61.231.187"
set PASS "Photoshop09@"
set REMOTE "/root/grafty_bsp"
set timeout 30

proc ssh_cmd {server pass cmd} {
    spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no -o PasswordAuthentication=yes $server $cmd
    expect {
        "password:" { send "$pass\r"; exp_continue }
        eof
    }
    wait
}

set timeout 60

# Run psql query on VPS
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no -o PasswordAuthentication=yes $SERVER "docker exec grafty_postgres psql -U grafty -d graftydb -c \"SELECT id, name FROM flows WHERE workspace_id = '3b04fc39-771d-4add-b3aa-bd4373dc84f7' ORDER BY created_at DESC LIMIT 5;\""
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}
wait

puts "\n\n=== GETTING PAYMENT NODE DATA ==="
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no -o PasswordAuthentication=yes $SERVER {docker exec grafty_postgres psql -U grafty -d graftydb -c "SELECT id, name, jsonb_path_query_array(nodes::jsonb, '$[*] ? (@.type == \"payment\" || @.type == \"Payment\")') as payment_nodes FROM flows WHERE workspace_id = '3b04fc39-771d-4add-b3aa-bd4373dc84f7' ORDER BY created_at DESC LIMIT 3;"}
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}
wait

puts "\n\n=== GETTING ACTIVE SESSIONS ==="
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no -o PasswordAuthentication=yes $SERVER {docker exec grafty_postgres psql -U grafty -d graftydb -c "SELECT id, current_node_id, state, is_completed, updated_at FROM flow_sessions WHERE workspace_id = '3b04fc39-771d-4add-b3aa-bd4373dc84f7' AND is_completed = false ORDER BY updated_at DESC LIMIT 5;"}
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}
wait

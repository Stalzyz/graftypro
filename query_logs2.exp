#!/usr/bin/expect -f
set SERVER "root@72.61.231.187"
set PASS "Photoshop09@"
set timeout 15
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "cd /root/grafty_bsp && docker compose -f docker-compose.prod.yml logs --tail=5000 web > /root/grafty_bsp/web.log && grep -i 'foreign key' /root/grafty_bsp/web.log"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

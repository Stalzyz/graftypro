#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set REMOTE    "/root/grafty_bsp"
set timeout   900

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER
expect {
    "password:" { send "$PASS\r" }
}

expect "# "
send "cd $REMOTE && git pull origin main\r"
expect "# "

send "docker compose -f docker-compose.prod.yml build --no-cache web\r"
set timeout 600
expect "# "

send "docker compose -f docker-compose.prod.yml up -d --force-recreate web worker\r"
set timeout 120
expect "# "

send "sleep 30\r"
set timeout 60
expect "# "

send {docker compose -f docker-compose.prod.yml exec -T web npx ts-node -e "const {PrismaClient}=require('@prisma/client');const p=new PrismaClient();p.flow.updateMany({where:{name:{in:['Fit Zone']},status:'DRAFT'},data:{status:'PUBLISHED'}}).then(r=>console.log('Updated:',r.count)).catch(console.error)"}
send "\r"
set timeout 60
expect "# "

send "docker compose -f docker-compose.prod.yml ps\r"
expect "# "

send "docker compose -f docker-compose.prod.yml logs --tail=20 worker\r"
expect "# "

send "exit\r"
expect eof

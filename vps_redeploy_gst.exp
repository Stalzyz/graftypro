#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set timeout   600

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "cd /root/grafty_bsp && git clean -fd && git reset --hard && git pull origin main && docker compose -f docker-compose.prod.yml up -d --build 2>&1"

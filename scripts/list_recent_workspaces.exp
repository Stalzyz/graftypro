#!/usr/bin/expect -f

set SERVER "root@72.61.231.187"
set PASS "Photoshop09@"
set timeout 60

puts "==> Listing recent workspaces (last 20)..."
spawn ssh -o StrictHostKeyChecking=no $SERVER {docker exec grafty_postgres psql -U user -d wabot_bsp -c "SELECT w.id, w.name, w.business_name, w.created_at FROM workspaces w ORDER BY w.created_at DESC LIMIT 20;"}
expect {
    "assphrase" { send "$PASS\r"; exp_continue }
    eof
}

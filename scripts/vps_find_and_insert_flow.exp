#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set REMOTE    "/root/grafty_bsp"
set timeout   600

puts "\nSearching workspaces on VPS production DB..."
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "cd $REMOTE && docker compose -f docker-compose.prod.yml exec -T web node -e \"const { PrismaClient } = require('@prisma/client'); const p = new PrismaClient(); p.workspace.findMany({ select: { id: true, name: true, business_name: true } }).then(w => console.log(JSON.stringify(w, null, 2)));\""
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

puts "\nExecuting flow creation script inside Docker container..."
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "cd $REMOTE && docker compose -f docker-compose.prod.yml exec -T web npx tsx scripts/create_grekam_ecommerce_flow.ts"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

puts "\nRegistering autoresponder keyword triggers..."
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "cd $REMOTE && docker compose -f docker-compose.prod.yml exec -T web npx tsx scripts/register_grekam_triggers.ts"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

puts "\nVPS FLOW INSERTION COMPLETE"

#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set timeout   60

spawn ssh -o StrictHostKeyChecking=no $SERVER "echo '=== DISK USAGE ===' && df -h && echo '\n=== DOCKER USAGE ===' && docker system df && echo '\n=== TOP 20 LARGEST DIRS/FILES ===' && du -ahx / | sort -rh | head -n 20"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

#!/usr/bin/expect -f
set SERVER "root@72.61.231.187"
set PASS "Photoshop09@"
set timeout 10
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "pm2 show send-grafty | grep -i port; pm2 show grekam-os-web | grep -i port"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

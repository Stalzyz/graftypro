#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set timeout   300

puts "\n🚀 \[1/3\] Deleting Build Cache (Safe)..."
spawn ssh -o StrictHostKeyChecking=no $SERVER "docker builder prune -a -f"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

puts "\n🚀 \[2/3\] Deleting Unused Images (Safe)..."
spawn ssh -o StrictHostKeyChecking=no $SERVER "docker image prune -a -f"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

puts "\n🚀 \[3/3\] Rebuilding & Restarting Grafty Containers..."
spawn ssh -o StrictHostKeyChecking=no $SERVER "cd /root/grafty_bsp && docker compose -f docker-compose.prod.yml up -d --build"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

puts "\n✅ CLEANUP & DEPLOYMENT COMPLETE"

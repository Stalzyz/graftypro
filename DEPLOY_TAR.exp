#!/usr/bin/expect -f

set SERVER "root@72.61.231.187"
set PASS "Photoshop09@"
set REMOTE "/root/grafty_bsp"
set timeout -1

puts "==> Uploading hotfix.tar.gz..."
spawn scp -o StrictHostKeyChecking=no hotfix.tar.gz $SERVER:$REMOTE/hotfix.tar.gz
expect {
    "assword:" { send "$PASS\r"; exp_continue }
    "assphrase" { send "$PASS\r"; exp_continue }
    eof
}

puts "==> Extracting and Rebuilding..."
spawn ssh -o StrictHostKeyChecking=no $SERVER "cd $REMOTE && tar -xzf hotfix.tar.gz && docker compose -f docker-compose.prod.yml down && docker compose -f docker-compose.prod.yml up -d --build"
expect {
    "assword:" { send "$PASS\r"; exp_continue }
    "assphrase" { send "$PASS\r"; exp_continue }
    eof
}

puts "✅ DONE"

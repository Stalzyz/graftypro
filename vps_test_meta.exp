#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set timeout   60

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "docker exec grafty_bsp-worker-1 npx tsx -e \"
const axios = require('axios');
const prisma = require('@prisma/client');
const p = new prisma.PrismaClient();

async function run() {
    const ws = await p.workspace.findUnique({ where: { id: '89b6c788-d842-4bf6-8af9-bc02e84e76d2' }, include: { waba: true } });
    const crypto = require('crypto');
    function decrypt(text) {
        if (!text) return '';
        const parts = text.split(':');
        if (parts.length !== 2) return text;
        const iv = Buffer.from(parts[0], 'hex');
        const encryptedText = Buffer.from(parts[1], 'hex');
        const decipher = crypto.createDecipheriv('aes-256-cbc', Buffer.from(process.env.ENCRYPTION_KEY || 'default-key-32-chars-long-here!'), iv);
        let decrypted = decipher.update(encryptedText);
        decrypted = Buffer.concat([decrypted, decipher.final()]);
        return decrypted.toString();
    }
    const token = decrypt(ws.waba.access_token);
    
    try {
        const res = await axios.post(\\\`https://graph.facebook.com/v19.0/\\\${ws.waba.phone_number_id}/messages\\\`, {
            messaging_product: 'whatsapp',
            to: '1234567890', // invalid number, but we just want to see if it complains about template format or billing
            type: 'template',
            template: {
                name: 'grafty_for_shopify',
                language: { code: 'en_US' }
            }
        }, {
            headers: { Authorization: \\\`Bearer \\\${token}\\\`, 'Content-Type': 'application/json' }
        });
        console.log(res.data);
    } catch (e) {
        console.error('ERROR:', e.response?.data || e.message);
    }
}
run();
\""
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

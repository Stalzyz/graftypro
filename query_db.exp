#!/usr/bin/expect -f
set SERVER "root@72.61.231.187"
set PASS "Photoshop09@"
set timeout 20
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "cd /root/grafty_bsp && docker compose -f docker-compose.prod.yml exec -T web node -e \"const { PrismaClient } = require('@prisma/client'); const prisma = new PrismaClient(); async function main() { const ws = await prisma.workspace.findMany({ select: { id: true, plan: true, subscription_status: true, current_plan_id: true } }); console.log(JSON.stringify(ws)); } main().finally(() => prisma.\\\$disconnect());\""
expect {
    "password:" { send "$PASS\r"; exp_continue }

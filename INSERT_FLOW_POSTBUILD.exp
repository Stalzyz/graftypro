#!/usr/bin/expect -f
# Insert e-commerce flow via docker cp + exec (post-build)

set SERVER "root@72.61.231.187"
set PASS "Photoshop09@"
set timeout 120

puts "==> Copying insert script into running container..."
spawn ssh -o StrictHostKeyChecking=no $SERVER {docker cp /root/grafty_bsp/scripts/insert_ecommerce_flow.ts grafty_bsp-web-1:/app/scripts/insert_ecommerce_flow.ts}
expect {
    "assphrase" { send "$PASS\r"; exp_continue }
    eof
}

puts "==> Running flow insert inside container..."
spawn ssh -o StrictHostKeyChecking=no $SERVER {docker exec grafty_bsp-web-1 npx tsx scripts/insert_ecommerce_flow.ts}
expect {
    "assphrase" { send "$PASS\r"; exp_continue }
    eof
}

puts "DONE: Flow inserted successfully"

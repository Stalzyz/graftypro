#!/usr/bin/expect -f
set SERVER "root@72.61.231.187"
set PASS   "Photoshop09@"
set timeout 300

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "
cd /root/grafty_bsp && \

echo '=== Stash local VPS changes (from earlier SCP) ===' && \
git stash && \

echo '=== Git pull latest from origin/main ===' && \
git pull origin main && \
git log --oneline -3 && \

echo '' && \
echo '=== Running tag separation migration in web container ===' && \
docker cp fix_tags_89b6c788.ts grafty_bsp-web-1:/app/fix_tags_89b6c788.ts && \
docker exec grafty_bsp-web-1 npx tsx /app/fix_tags_89b6c788.ts && \

echo '' && \
echo '=== Rebuilding web image with latest code ===' && \
docker compose -f docker-compose.prod.yml build --no-cache web 2>&1 | tail -10 && \

echo '=== Restarting containers ===' && \
docker compose -f docker-compose.prod.yml up -d --no-build web worker && \
sleep 15 && \

echo '' && \
echo '=== Final container status ===' && \
docker compose -f docker-compose.prod.yml ps --format 'table {{.Name}}\t{{.Status}}'
"

expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set timeout   60

spawn ssh -o StrictHostKeyChecking=no $SERVER "echo '=== CONTAINERS ===' && docker ps -a && echo '\n=== VOLUMES ===' && docker volume ls"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

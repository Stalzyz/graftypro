set PASS      "Photoshop09@"
set timeout   60

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "docker exec grafty_postgres psql -U user -d wabot_bsp -c \"SELECT name, template_name FROM campaigns WHERE id = 'bc82b3c5-ba08-4631-a7b6-f6ce0369ac3f';\""
expect {

#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set REMOTE    "/root/grafty_bsp"
set timeout   300

puts "\n🚀 \[1/2\] Syncing local files to VPS via rsync..."
spawn rsync -avz -e "ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no" --exclude="node_modules" --exclude=".git" --exclude=".env" ./ $SERVER:$REMOTE/
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}

puts "\n🚀 \[2/2\] Rebuilding Docker container on VPS..."
spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "cd $REMOTE && docker compose -f docker-compose.prod.yml down && docker compose -f docker-compose.prod.yml up -d --build"
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}
puts "\n✅ DEPLOYMENT COMPLETE"

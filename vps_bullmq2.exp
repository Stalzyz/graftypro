#!/usr/bin/expect -f
set SERVER    "root@72.61.231.187"
set PASS      "Photoshop09@"
set timeout   60

spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no $SERVER "docker exec grafty_bsp-worker-1 node -e \"
const { Queue } = require('bullmq');
const connection = { host: 'redis', port: 6379 };
const q = new Queue('meta-api-queue', { connection });
async function check() {
    console.log('Waiting:', await q.getWaitingCount());
    console.log('Delayed:', await q.getDelayedCount());
    console.log('Active:', await q.getActiveCount());
    console.log('Failed:', await q.getFailedCount());
    const failed = await q.getFailed(0, 10);
    console.log('Failed Jobs:', failed.map(j => ({ id: j.id, err: j.failedReason })));
    process.exit(0);
}
check();
\""
expect {
    "password:" { send "$PASS\r"; exp_continue }
    eof
}
